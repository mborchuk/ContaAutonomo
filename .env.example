# Copy to .env and fill in. `make setup` generates a SECRET_KEY for you.

# Required in production. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# SQLAlchemy database URI (default: sqlite:///invoices.db)
DATABASE_URL=sqlite:///invoices.db

# Set 1 to enable HSTS + secure cookies (use behind HTTPS).
FORCE_HTTPS=0

# Set 1 for debug mode / dev (relaxes the SECRET_KEY requirement).
FLASK_DEBUG=0

# Optional: path to the auth config JSON (default: instance/auth_config.json)
# AUTH_CONFIG_PATH=instance/auth_config.json

# Optional: enable Sentry error tracking.
# SENTRY_DSN=

# Optional: dev server bind (python app.py only).
# HOST=127.0.0.1
# PORT=5000
