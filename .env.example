# Copy to .env and fill in. `make setup` generates a SECRET_KEY for you.

# Required in production. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# SQLAlchemy database URI (default: sqlite:///invoices.db)
DATABASE_URL=sqlite:///invoices.db

# Set 1 to enable HSTS + secure cookies (use behind HTTPS).
FORCE_HTTPS=0

# Set 1 for debug mode / dev (relaxes the SECRET_KEY requirement).
FLASK_DEBUG=0

# Backup encryption key (backup module, method "Use the backup key").
# Keep a copy in a password manager: encrypted backups cannot be restored
# without it. Empty: a key file is created at instance/backup.key
# (override the path with BACKUP_KEY_FILE).
BACKUP_KEY=

# Behind a reverse proxy (nginx, Caddy): number of proxies in front of the
# app, so rate limits and login lockout see the client address. Keep 0 when
# the app is reached directly.
TRUSTED_PROXY_COUNT=0

# Optional: shared rate-limit storage when running more than one worker,
# e.g. redis://redis:6379 (needs the redis package). Default memory://.
# RATELIMIT_STORAGE_URI=memory://

# Optional: path to the auth config JSON (default: instance/auth_config.json)
# AUTH_CONFIG_PATH=instance/auth_config.json

# Optional: enable Sentry error tracking.
# SENTRY_DSN=

# Optional: dev server bind (python app.py only).
# HOST=127.0.0.1
# PORT=5000
