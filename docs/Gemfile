source "https://rubygems.org"

# Jekyll 4.x — local build (GitHub Actions builds the site, not GitHub Pages
# native build, so we are not constrained to the github-pages gem).
gem "jekyll", "~> 4.3"

# Plugins must live in the :jekyll_plugins group to be auto-loaded by Jekyll
# when listed under `plugins:` in _config.yml.
group :jekyll_plugins do
  gem "jekyll-seo-tag", "~> 2.8"
  gem "jekyll-sitemap", "~> 1.4"
end

# Dev / CI-only tooling for link and HTML validation.
group :development, :test do
  gem "html-proofer", "~> 5.0"
end

# Windows and JRuby do not include zoneinfo files, so bundle the tzinfo-data
# gem and associated library.
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end

# Performance booster for watching directories on Windows.
gem "wdm", "~> 0.1.1", :platforms => [:mingw, :x64_mingw, :mswin]
