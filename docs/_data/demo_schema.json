{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "tables"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "tables": {
      "type": "object",
      "required": [
        "customer",
        "invoice",
        "expense"
      ],
      "properties": {
        "customer": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "name",
              "country",
              "tax_type"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "vat_number": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "country": {
                "type": "string"
              },
              "tax_type": {
                "enum": [
                  "eu_b2b",
                  "non_eu",
                  "standard"
                ]
              }
            }
          }
        },
        "invoice": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "invoice_number",
              "client_name",
              "amount_eur",
              "currency",
              "status",
              "invoice_date"
            ],
            "properties": {
              "amount_eur": {
                "type": "number",
                "minimum": 0
              },
              "status": {
                "enum": [
                  "paid",
                  "pending",
                  "overdue"
                ]
              },
              "currency": {
                "type": "string",
                "minLength": 3,
                "maxLength": 3
              }
            }
          }
        },
        "expense": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "amount",
              "currency",
              "category",
              "expense_date"
            ],
            "properties": {
              "category": {
                "type": "string"
              },
              "amount": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
